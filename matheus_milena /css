body {
    background-color: #111;
    color: white;
    font-family: Arial, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
}

.container {
    text-align: center;
}

.timer {
    border: 2px solid #ff4081;
    padding: 20px;
    border-radius: 15px;
}

.foto-casal {
    width: 300px; /* ajuste como necessário */
    height: auto;
    border-radius: 10px;
    margin-bottom: 20px;
}